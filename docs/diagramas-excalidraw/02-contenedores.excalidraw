    {
      "id": "notes-3031-1-body",
      "type": "text",
      "x": 889.08798828125,
      "y": 3104.9458984375,
      "width": 704.4189453125,
      "height": 275,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
