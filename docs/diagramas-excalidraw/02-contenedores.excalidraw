    {
      "id": "notes-2677-1-body",
      "type": "text",
      "x": 1156.783984375,
      "y": 2751.6958984375,
      "width": 990.12890625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2677-1"
      ],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 84356829,
      "version": 2,
      "versionNonce": 1525458013,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237745263,
      "link": null,
      "locked": false,
      "text": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. Workers procesan\ndespués la outbox confirmada. Un ACK no certifica contabilización ERP, aceptación fiscal ni\nliquidación del pago.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. Workers procesan\ndespués la outbox confirmada. Un ACK no certifica contabilización ERP, aceptación fiscal ni\nliquidación del pago.",
