    {
      "id": "notes-3031-12-body",
      "type": "text",
      "x": 86,
      "y": 4522.1958984375,
      "width": 720.3173828125,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
