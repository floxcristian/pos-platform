    {
      "id": "notes-2677-0-body",
      "type": "text",
      "x": 86,
      "y": 2751.6958984375,
      "width": 989.3447265625,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
