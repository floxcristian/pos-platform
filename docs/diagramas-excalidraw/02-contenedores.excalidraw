      "text": "Adaptador ERP / ACL",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Adaptador ERP / ACL",
      "autoResize": true,
