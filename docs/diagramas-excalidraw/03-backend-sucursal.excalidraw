      "boundElements": [],
      "updated": 1791237745550,
      "link": null,
      "locked": false,
      "text": "Los bloques interiores llaman código TypeScript. No hay HTTP ni bases\nseparadas entre módulos. UI valida experiencia; el backend valida\npermisos, integridad, turno y capacidades antes de mutar negocio.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Los bloques interiores llaman código TypeScript. No hay HTTP ni bases\nseparadas entre módulos. UI valida experiencia; el backend valida\npermisos, integridad, turno y capacidades antes de mutar negocio.",
      "autoResize": true,
      "lineHeight": 1.25
    },
