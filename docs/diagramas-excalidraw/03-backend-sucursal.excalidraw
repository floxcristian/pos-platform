      "text": "Precios y caja son dominios diferentes",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Precios y caja son dominios diferentes",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-2881-2-body",
      "type": "text",
      "x": 1688.7156249999998,
      "y": 2955.3856445312504,
      "width": 693.4296875,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2881-2"
      ],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 1884151955,
      "version": 2,
      "versionNonce": 364759603,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237745550,
      "link": null,
      "locked": false,
      "text": "La cotización fija versión inmutable y revalida vigencia antes de cobrar.\nTurno de caja no equivale a sesión de acceso. Devoluciones y\ncompensaciones son nuevas operaciones auditables; no reescritura de\nhistoria.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La cotización fija versión inmutable y revalida vigencia antes de cobrar.\nTurno de caja no equivale a sesión de acceso. Devoluciones y\ncompensaciones son nuevas operaciones auditables; no reescritura de\nhistoria.",
      "autoResize": true,
      "lineHeight": 1.25
    },
