    {
      "id": "notes-3234-8-body",
      "type": "text",
      "x": 1688.7156249999998,
      "y": 4207.63564453125,
      "width": 713.603515625,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
