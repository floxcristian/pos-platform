      "versionNonce": 875810397,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237746407,
      "link": null,
      "locked": false,
      "text": "Cliente de caja\n«Contenedor»\nAngular + Tauri\nEnvía comandos identificados y\npresenta el resultado durable al\noperador.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "client",
      "originalText": "Cliente de caja\n«Contenedor»\nAngular + Tauri\nEnvía comandos identificados y\npresenta el resultado durable al\noperador.",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
