      "versionNonce": 880579059,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237746407,
      "link": null,
      "locked": false,
      "text": "Backend de sucursal\n«Contenedor»\nNestJS + Fastify / Node.js\nAutoriza la operación y coordina\nnegocio, pago y evidencia local.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "branchApi",
      "originalText": "Backend de sucursal\n«Contenedor»\nNestJS + Fastify / Node.js\nAutoriza la operación y coordina\nnegocio, pago y evidencia local.",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
