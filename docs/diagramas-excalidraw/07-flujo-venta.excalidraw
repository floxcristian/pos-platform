      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237746407,
      "link": null,
      "locked": false,
      "text": "Datos de sucursal\n«Contenedor de datos»\nPostgreSQL\nCustodia intención, venta, caja,\nauditoría y outbox en un\nprimario compartido.",
