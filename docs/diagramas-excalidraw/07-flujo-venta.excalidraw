    },
    {
      "id": "notes-3715-2-title",
      "type": "text",
      "x": 1758.6666666666667,
      "y": 3736.5,
      "width": 543.359375,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3715-2"
      ],
      "frameId": null,
      "index": "b0M",
      "roundness": null,
      "seed": 2147115709,
      "version": 2,
      "versionNonce": 1441527069,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237746405,
      "link": null,
      "locked": false,
      "text": "Fiscalidad e impresión tienen su propio resultado",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fiscalidad e impresión tienen su propio resultado",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "notes-3715-2-body",
      "type": "text",
      "x": 1758.6666666666667,
      "y": 3788.75,
      "width": 736.09765625,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-3715-2"
      ],
      "frameId": null,
      "index": "b0N",
      "roundness": null,
      "seed": 1566569363,
      "version": 2,
      "versionNonce": 1187985203,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237746405,
      "link": null,
      "locked": false,
      "text": "Solo se confirman operaciones y documentos permitidos por la modalidad\nnacional habilitada. Las llamadas fiscales conservan referencia, estado y\nrecuperación fuera de una transacción distribuida. Un fallo de impresión\npermite reimprimir el mismo documento; no genera otra venta ni otro cargo.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Solo se confirman operaciones y documentos permitidos por la modalidad\nnacional habilitada. Las llamadas fiscales conservan referencia, estado y\nrecuperación fuera de una transacción distribuida. Un fallo de impresión\npermite reimprimir el mismo documento; no genera otra venta ni otro cargo.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
