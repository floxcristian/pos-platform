    {
      "id": "05-notes-2775-7-body",
      "type": "text",
      "x": 6810.555224609374,
      "y": 8869.39013671875,
      "width": 815.7080078125,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
