    {
      "id": "03-notes-2881-2-body",
      "type": "text",
      "x": 9703.064453125,
      "y": 2955.3856445312504,
      "width": 693.4296875,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
