    {
      "id": "02-notes-3031-11-body",
      "type": "text",
      "x": 6502.438378906249,
      "y": 4058.9458984375,
      "width": 721.080078125,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
