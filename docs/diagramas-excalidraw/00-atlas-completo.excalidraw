    {
      "id": "03-notes-2881-0-body",
      "type": "text",
      "x": 8100.348828124999,
      "y": 2955.3856445312504,
      "width": 700.6806640625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
