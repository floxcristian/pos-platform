    {
      "id": "03-notes-2881-1-body",
      "type": "text",
      "x": 8901.706640625,
      "y": 2955.3856445312504,
      "width": 677.5205078125,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "03-notes-2881-1"
      ],
      "frameId": "03-frame",
      "index": "b0SGl",
      "roundness": null,
      "seed": 712464733,
      "version": 3,
      "versionNonce": 1825172979,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237752444,
      "link": null,
      "locked": false,
      "text": "Intención de pago durable antes de invocar el proveedor; resultado y\nconfirmación local después. Venta + auditoría + outbox se confirman\njuntas. Venta, pago, fiscalidad y ERP conservan estados separados y\nrecuperación explícita.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Intención de pago durable antes de invocar el proveedor; resultado y\nconfirmación local después. Venta + auditoría + outbox se confirman\njuntas. Venta, pago, fiscalidad y ERP conservan estados separados y\nrecuperación explícita.",
      "autoResize": true,
      "lineHeight": 1.25
    },
