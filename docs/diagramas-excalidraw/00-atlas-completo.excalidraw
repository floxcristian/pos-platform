    {
      "id": "02-notes-3031-3-body",
      "type": "text",
      "x": 6502.438378906249,
      "y": 3104.9458984375,
      "width": 732.48828125,
      "height": 302.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
