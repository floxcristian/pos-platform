      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237752445,
      "link": null,
      "locked": false,
      "text": "Pago desconocido o aprobado sin commit local",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pago desconocido o aprobado sin commit local",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "07-notes-3715-0-body",
      "type": "text",
      "x": 86,
      "y": 14388.64013671875,
      "width": 768.001953125,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "07-notes-3715-0"
      ],
      "frameId": "07-frame",
      "index": "b0dmV",
      "roundness": null,
      "seed": 760380083,
      "version": 3,
      "versionNonce": 1074508541,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237752445,
      "link": null,
      "locked": false,
      "text": "Un timeout conserva el intento y su incertidumbre: consulta o conciliación\nsegún capacidad, sin recargar ni cambiar automáticamente de proveedor. Si el\npago se aprobó y falla el commit local, se recuperan intención y evidencia; una\nreversa o intervención controlada conserva el intento original.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un timeout conserva el intento y su incertidumbre: consulta o conciliación\nsegún capacidad, sin recargar ni cambiar automáticamente de proveedor. Si el\npago se aprobó y falla el commit local, se recuperan intención y evidencia; una\nreversa o intervención controlada conserva el intento original.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "07-notes-3715-1-bg",
      "type": "rectangle",
      "x": 900.3333333333334,
      "y": 14314.39013671875,
      "width": 812.3333333333334,
      "height": 219.25,
      "angle": 0,
      "strokeColor": "#CCD7E8",
      "backgroundColor": "#F7F9FD",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
