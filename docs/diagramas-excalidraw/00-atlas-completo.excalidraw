      "roundness": {
        "type": 3
      },
      "seed": 723033149,
      "version": 3,
      "versionNonce": 1764748563,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237752445,
      "link": null,
      "locked": false
    },
    {
      "id": "07-notes-3715-5-title",
      "type": "text",
      "x": 1758.6666666666667,
      "y": 14579.64013671875,
      "width": 397.42431640625,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "07-notes-3715-5"
      ],
      "frameId": "07-frame",
      "index": "b0dv",
      "roundness": null,
      "seed": 628888083,
      "version": 3,
      "versionNonce": 1944019357,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237752445,
      "link": null,
      "locked": false,
      "text": "ERP posterior no es el ACK de país",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ERP posterior no es el ACK de país",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "07-notes-3715-5-body",
      "type": "text",
      "x": 1758.6666666666667,
      "y": 14631.89013671875,
      "width": 768.087890625,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "07-notes-3715-5"
      ],
      "frameId": "07-frame",
      "index": "b0dvV",
      "roundness": null,
      "seed": 227806365,
      "version": 3,
      "versionNonce": 1165415091,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237752445,
      "link": null,
      "locked": false,
      "text": "Workers de país consumen outbox ya confirmada y usan el adaptador\nERP/ACL con destino y referencia persistidos. Registro, rechazo,\ncontabilización y conciliación tienen estados propios. La caída del ERP deja\nintegración pendiente; país no se convierte en segundo autor de la venta local.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Workers de país consumen outbox ya confirmada y usan el adaptador\nERP/ACL con destino y referencia persistidos. Registro, rechazo,\ncontabilización y conciliación tienen estados propios. La caída del ERP deja\nintegración pendiente; país no se convierte en segundo autor de la venta local.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "07-footer",
      "type": "text",
      "x": 64,
      "y": 14830.89013671875,
      "width": 1424.169921875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#4C607D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "07-frame",
      "index": "b0dw",
      "roundness": null,
      "seed": 1324767155,
      "version": 3,
      "versionNonce": 270214653,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237752445,
      "link": null,
      "locked": false,
      "text": "C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "07-glossary",
      "type": "text",
      "x": 64,
