    {
      "id": "04-notes-2557-0-body",
      "type": "text",
      "x": 86,
      "y": 8188.771289062501,
      "width": 683.6328125,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "04-notes-2557-0"
      ],
      "frameId": "04-frame",
      "index": "b0SUG",
      "roundness": null,
      "seed": 1555277629,
      "version": 3,
      "versionNonce": 199212563,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237752444,
      "link": null,
      "locked": false,
      "text": "Calendario y zona horaria IANA, ventanas, límites, backoff y jitter son\nconfiguración explícita. Carga masiva programada o manual utiliza el\nmismo pipeline auditado. Una ejecución manual no salta validaciones.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Calendario y zona horaria IANA, ventanas, límites, backoff y jitter son\nconfiguración explícita. Carga masiva programada o manual utiliza el\nmismo pipeline auditado. Una ejecución manual no salta validaciones.",
      "autoResize": true,
      "lineHeight": 1.25
    },
