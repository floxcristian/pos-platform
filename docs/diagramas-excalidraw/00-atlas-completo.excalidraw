    {
      "id": "05-notes-2449-2-body",
      "type": "text",
      "x": 6508.6240234375,
      "y": 8080.39013671875,
      "width": 1137.3076171875,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
