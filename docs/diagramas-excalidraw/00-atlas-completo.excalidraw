      "width": 812.3333333333334,
      "height": 219.25,
      "angle": 0,
      "strokeColor": "#CCD7E8",
      "backgroundColor": "#F7F9FD",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
