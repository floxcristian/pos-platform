    {
      "id": "02-notes-2677-1-body",
      "type": "text",
      "x": 5163.958398437499,
      "y": 2751.6958984375,
      "width": 990.12890625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
