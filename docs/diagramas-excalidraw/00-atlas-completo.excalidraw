    {
      "id": "07-notes-3715-1-title",
      "type": "text",
      "x": 922.3333333333334,
      "y": 14336.39013671875,
      "width": 373.828125,
      "height": 31.25,
      "angle": 0,
      "strokeColor": "#0545BA",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "07-notes-3715-1"
      ],
      "frameId": "07-frame",
      "index": "b0dnV",
      "roundness": null,
      "seed": 758557779,
      "version": 3,
      "versionNonce": 695618397,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237752445,
      "link": null,
      "locked": false,
      "text": "SDK local es una ruta condicional",
      "fontSize": 25,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SDK local es una ruta condicional",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "07-notes-3715-1-body",
      "type": "text",
      "x": 922.3333333333334,
      "y": 14388.64013671875,
      "width": 721.5634765625,
      "height": 110,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "07-notes-3715-1"
      ],
      "frameId": "07-frame",
      "index": "b0do",
      "roundness": null,
      "seed": 1746351709,
      "version": 3,
      "versionNonce": 141321459,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237752445,
      "link": null,
      "locked": false,
      "text": "La vista muestra una API ejecutada desde backend. Si el proveedor exige\nSDK local homologado, el cliente transporta al puente de periféricos el\ncomando original autorizado por backend y retorna evidencia. No inventa\nimporte o permiso, ni ejecuta ambas rutas para un mismo intento.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La vista muestra una API ejecutada desde backend. Si el proveedor exige\nSDK local homologado, el cliente transporta al puente de periféricos el\ncomando original autorizado por backend y retorna evidencia. No inventa\nimporte o permiso, ni ejecuta ambas rutas para un mismo intento.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "07-notes-3715-2-bg",
      "type": "rectangle",
      "x": 1736.6666666666667,
