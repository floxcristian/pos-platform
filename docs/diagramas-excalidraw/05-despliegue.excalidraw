    {
      "id": "notes-2449-1-body",
      "type": "text",
      "x": 1293.7248046875,
      "y": 2523.0044921874996,
      "width": 1104.3291015625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#182842",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "notes-2449-1"
      ],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 691291123,
      "version": 2,
      "versionNonce": 1744497021,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237746066,
      "link": null,
      "locked": false,
      "text": "Identidad de usuario y puesto, permisos por sucursal/país, TLS y credenciales de mínimos privilegios. Logs\ncorrelacionan commandId/eventId/intento. Observar cola pendiente, antigüedad, fallos, huecos y versión/vigencia\nactiva.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Identidad de usuario y puesto, permisos por sucursal/país, TLS y credenciales de mínimos privilegios. Logs\ncorrelacionan commandId/eventId/intento. Observar cola pendiente, antigüedad, fallos, huecos y versión/vigencia\nactiva.",
      "autoResize": true,
      "lineHeight": 1.25
    },
