        "notes-2449-0"
      ],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 1559593981,
      "version": 2,
      "versionNonce": 1261126035,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791237746066,
      "link": null,
      "locked": false,
      "text": "Sin WAN pueden continuar operaciones autorizadas con LAN y escritor sanos. Sin LAN/backend se detienen\nnuevos comandos dependientes; el puesto no se convierte en escritor de emergencia. La autonomía por terminal\nsería otro perfil de arquitectura.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sin WAN pueden continuar operaciones autorizadas con LAN y escritor sanos. Sin LAN/backend se detienen\nnuevos comandos dependientes; el puesto no se convierte en escritor de emergencia. La autonomía por terminal\nsería otro perfil de arquitectura.",
      "autoResize": true,
      "lineHeight": 1.25
    },
