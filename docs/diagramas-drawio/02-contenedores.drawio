        </mxCell>
        <mxCell id="client" value="" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=1.5;fillColor=#EDF3FF;rounded=0;arcSize=8;">
          <mxGeometry x="2122.223828" y="992.2" width="379.1625" height="160.8" as="geometry" />
        </mxCell>
        <mxCell id="device" value="" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=1.5;fillColor=#EDF3FF;rounded=0;arcSize=8;">
          <mxGeometry x="2354.095703" y="1369" width="403.21875" height="134.4" as="geometry" />
        </mxCell>
        <mxCell id="branchApi" value="" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=1.5;fillColor=#EDF3FF;rounded=0;arcSize=8;">
          <mxGeometry x="1847.273828" y="1369" width="441.2625" height="134.4" as="geometry" />
        </mxCell>
        <mxCell id="branchDb" value="" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#6545A4;strokeWidth=1.5;fillColor=#F2EEFA;rounded=0;arcSize=8;">
          <mxGeometry x="2133.764453" y="1692.999954" width="366.675" height="210.271381" as="geometry" />
