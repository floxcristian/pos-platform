        <mxCell id="legend-desc" value="Flecha: iniciador → destino; texto: propósito y protocolo. Borde discontinuo: límite nombrado. Todo el contenido es editable." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=19;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="330" width="1039.266602" height="23.75" as="geometry" />
        </mxCell>
        <mxCell id="reading-title" value="Contratos que gobiernan esta vista" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2613.445898" width="496.3125" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-2677-0-bg" value="" parent="group-notes-2677-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1046.783984" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2677-0-title" value="PostgreSQL, con responsabilidades explícitas" parent="group-notes-2677-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="510.009766" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2677-0-body" value="Relaciones, restricciones, transacciones y outbox/inbox comparten un commit local. JSONB admite&#10;payloads variables. PostgreSQL de país conserva integración y proyecciones; no cambia la autoridad&#10;de ventas. MongoDB también soporta transacciones; una segunda base requiere una necesidad&#10;probada." parent="group-notes-2677-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="989.344727" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-2677-1-bg" value="" parent="group-notes-2677-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1046.783984" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2677-1-title" value="Entrega durable y ACK de aplicación" parent="group-notes-2677-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="408.581543" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2677-1-body" value="País confirma inbox + efecto/proyección local + outbox antes de acusar aplicación. Workers procesan&#10;después la outbox confirmada. Un ACK no certifica contabilización ERP, aceptación fiscal ni&#10;liquidación del pago." parent="group-notes-2677-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="990.128906" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2677-2-bg" value="" parent="group-notes-2677-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1046.783984" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2677-2-title" value="Autonomía y efectos externos" parent="group-notes-2677-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="330.737305" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2677-2-body" value="No se sostiene SQL abierto esperando un proveedor. Un pago incierto se consulta o concilia con su&#10;identidad original. El puente es condicional según SDK y transporta autorización emitida por backend;&#10;no incorpora otra base de ventas." parent="group-notes-2677-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="991.826172" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2955.695898" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-0-bg" value="" parent="group-notes-3031-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="779.087988" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-0-title" value="Cajero" parent="group-notes-3031-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="73.64502" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-0-body" value="Persona · Operación humana&#10;&#10;Usa el cliente del puesto. Abrir o cerrar sesión de usuario no equivale a&#10;abrir o cerrar el turno de caja.&#10;&#10;AUTORIDAD · Ejecuta operaciones con permisos; no administra la base.&#10;&#10;CONTINUIDAD · Acceso local y operaciones habilitadas según vigencia,&#10;permisos y política offline." parent="group-notes-3031-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="712.464844" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-1-bg" value="" parent="group-notes-3031-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="779.087988" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-1-title" value="Cliente de caja" parent="group-notes-3031-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="165.380859" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-1-body" value="Contenedor · Angular + Tauri&#10;&#10;Cliente instalado en cada puesto. Capacidades nativas por permisos; su&#10;registro técnico de periféricos no lo convierte en autoridad de ventas.&#10;Hardware y SDK requieren homologación.&#10;&#10;AUTORIDAD · No posee otra base de ventas ni credenciales SQL.&#10;&#10;CONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se&#10;detienen nuevos comandos dependientes." parent="group-notes-3031-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="704.418945" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-2-bg" value="" parent="group-notes-3031-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="779.087988" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-2-title" value="Puente de periféricos" parent="group-notes-3031-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="236.254883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-2-body" value="Contenedor condicional · Proceso nativo según SDK&#10;&#10;El cliente transporta el comando autorizado por backend al agente; no&#10;inventa importe, permiso ni otro intento. Puede requerir .NET u otro&#10;runtime por contrato del proveedor. Se representa como límite por&#10;homologar, no como SDK aprobado.&#10;&#10;AUTORIDAD · Ejecuta identidad y autorización emitidas por backend;&#10;registro técnico de evidencia, sin base de ventas.&#10;&#10;CONTINUIDAD · Una caída de LAN tras un cobro exige recuperar&#10;evidencia; no autoriza otro cobro." parent="group-notes-3031-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="683.665039" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-3-bg" value="" parent="group-notes-3031-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="779.087988" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-3-title" value="Backend de sucursal" parent="group-notes-3031-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="232.080078" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-3-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;Monolito modular: acceso, ventas, caja, precios/ofertas, pagos y fiscalidad.&#10;Confirma negocio y outbox en una misma transacción PostgreSQL. No hay&#10;un microservicio por módulo.&#10;&#10;AUTORIDAD · Única autoridad de escritura del negocio de sucursal;&#10;módulos internos, un proceso.&#10;&#10;CONTINUIDAD · Opera por LAN con datos vigentes. Su caída exige&#10;recuperación del escritor autorizado." parent="group-notes-3031-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="732.488281" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-4-bg" value="" parent="group-notes-3031-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="779.087988" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-4-title" value="Datos de sucursal" parent="group-notes-3031-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="200.097656" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-4-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Ventas, caja, pagos y evidencia fiscal son locales. Inbox, outbox, cursores&#10;y staging tienen restricciones y transacciones. Catálogo, precios y&#10;promociones son réplicas de lectura autorizadas, no maestros&#10;independientes.&#10;&#10;AUTORIDAD · Base compartida por la tienda, un primario autorizado. API&#10;escribe negocio; worker escribe su esquema técnico y publica espejos por&#10;un contrato acotado.&#10;&#10;CONTINUIDAD · Persistencia local disponible sin WAN. No implica&#10;respaldo, alta disponibilidad ni recuperación automática." parent="group-notes-3031-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="723.9375" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-5-bg" value="" parent="group-notes-3031-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="779.087988" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-5-title" value="Sincronizador de sucursal" parent="group-notes-3031-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="287.646484" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-5-body" value="Contenedor · Worker TypeScript / Node.js&#10;&#10;Envía lotes HTTPS desde outbox con identidad y cursor; procesa acuses&#10;posteriores a commit. Recibe deltas o carga snapshot por staging,&#10;watermark, checksum y activación atómica.&#10;&#10;AUTORIDAD · Proceso supervisado; modifica datos técnicos y versiones&#10;de maestros, nunca venta libremente.&#10;&#10;CONTINUIDAD · Retiene pendientes durables y reanuda al recuperar&#10;WAN; limita reintentos y trabajo en curso." parent="group-notes-3031-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="712.9375" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-6-bg" value="" parent="group-notes-3031-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="779.087988" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-6-title" value="API de país" parent="group-notes-3031-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="129.248047" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-6-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;Valida identidad y contrato; aplica el efecto/proyección local junto con inbox&#10;y outbox en un único commit antes de acusar aplicación. No basta guardar&#10;la recepción. El ACK no declara éxito de ERP, pago ni fiscalidad.&#10;&#10;AUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y&#10;outbox juntos antes del ACK de aplicación.&#10;&#10;CONTINUIDAD · No participa en la transacción local de sucursal. Su caída&#10;genera atraso de sincronización." parent="group-notes-3031-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="734.604492" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-7-bg" value="" parent="group-notes-3031-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="779.087988" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-7-title" value="Workers de país" parent="group-notes-3031-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="181.555176" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-7-body" value="Contenedor · Workers NestJS / Node.js&#10;&#10;Procesa trabajo ya confirmado localmente para integración y conciliación;&#10;no difiere el efecto local requerido por el ACK de aplicación. Ingiere&#10;maestros autorizados, construye candidatas desde deltas o snapshots y&#10;valida su publicación.&#10;&#10;AUTORIDAD · Consume outbox confirmada por país; publica maestros y&#10;mantiene proyecciones derivadas.&#10;&#10;CONTINUIDAD · Avanza independientemente de tiendas desconectadas y&#10;limita fallos del ERP por país." parent="group-notes-3031-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="729.663086" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-8-bg" value="" parent="group-notes-3031-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="779.087988" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-8-title" value="Datos operativos de país" parent="group-notes-3031-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="276.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-8-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Aislamiento lógico y recursos por país/entidad legal. Retención, backups y&#10;deduplicación deben cubrir el horizonte de replay y restauración. ACK de&#10;aplicación local no equivale a contabilización ERP.&#10;&#10;AUTORIDAD · Proyección de operaciones de sucursal; inbox, outbox,&#10;versiones y resultados de integración.&#10;&#10;CONTINUIDAD · No sustituye la autoridad local ni habilita consumo&#10;concurrente offline de saldos globales." parent="group-notes-3031-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="723.948242" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-9-bg" value="" parent="group-notes-3031-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="779.087988" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-9-title" value="Adaptador ERP / ACL" parent="group-notes-3031-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="243.188477" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-9-body" value="Contenedor · Proceso TypeScript / Node.js&#10;&#10;ACL significa capa anticorrupción. Instancia/adaptador por país y ERP.&#10;Traduce identidades, documentos, moneda, impuestos, estados y errores;&#10;preserva destino y versión durante un cambio de ERP. El protocolo externo&#10;se valida por integración.&#10;&#10;AUTORIDAD · Dueño del mapeo y referencias técnicas; ERP conserva su&#10;autoridad de negocio.&#10;&#10;CONTINUIDAD · Desacoplado de la caja; conserva incertidumbre si no&#10;puede consultar un resultado." parent="group-notes-3031-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="732.123047" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-10-bg" value="" parent="group-notes-3031-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="779.087988" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-10-title" value="ERP del país" parent="group-notes-3031-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="145.910645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-10-body" value="Sistema externo · CL: AX · ES: Gira · PE: custom&#10;&#10;Chile usa Dynamics AX on-premise. Gira en España y custom en Perú son&#10;antecedentes; versión, interfaces y capacidades deben confirmarse. No se&#10;afirma que exista el adaptador objetivo en producción.&#10;&#10;AUTORIDAD · Autoridad financiera según contrato de cada país; no la&#10;base de ventas del POS.&#10;&#10;CONTINUIDAD · Su indisponibilidad deja integración pendiente; no&#10;revierte una venta local confirmada." parent="group-notes-3031-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="729.996094" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-11-bg" value="" parent="group-notes-3031-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="779.087988" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-11-title" value="Fuentes de maestros y precios" parent="group-notes-3031-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="341.821289" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-11-body" value="Sistema externo · Interfaces por confirmar&#10;&#10;Catálogo, impuestos, precios y promociones deben tener responsable,&#10;contrato, versión y vigencia. La fuente de precios no se sustituye por una&#10;tabla editada libremente en cada caja.&#10;&#10;AUTORIDAD · Propietario por dato y país pendiente: no se asigna al ERP&#10;por defecto.&#10;&#10;CONTINUIDAD · Sin WAN se usa la versión local vigente dentro de la&#10;política autorizada." parent="group-notes-3031-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="721.080078" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-12-bg" value="" parent="group-notes-3031-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="779.087988" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-12-title" value="Proveedor de pagos" parent="group-notes-3031-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-12-body" value="Sistema externo · API / SDK según proveedor&#10;&#10;Pago, venta, documento fiscal e integración ERP tienen estados distintos.&#10;No repetir un cargo incierto ni cambiar de proveedor para resolverlo&#10;automáticamente.&#10;&#10;AUTORIDAD · El proveedor mantiene el efecto financiero; POS registra&#10;intento, referencia y resultado.&#10;&#10;CONTINUIDAD · Disponibilidad y modo offline por homologar. Un timeout&#10;puede dejar resultado desconocido." parent="group-notes-3031-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="720.317383" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-13-bg" value="" parent="group-notes-3031-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="779.087988" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-13-title" value="Proveedor fiscal" parent="group-notes-3031-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="179.248047" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3031-13-body" value="Sistema externo · Contrato por país y modalidad&#10;&#10;Emisión, aceptación y transmisión se modelan por separado. No se inventa&#10;un proveedor común ni una capacidad de consulta o idempotencia no&#10;acreditada.&#10;&#10;AUTORIDAD · Autoridad y validez tributaria según régimen y proveedor.&#10;&#10;CONTINUIDAD · Emitir offline exige modalidad y material fiscal válidos; no&#10;se promete universalmente." parent="group-notes-3031-13" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="734.948242" height="275" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4918.695898" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4984.695898" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Angular + Tauri y Nx: dirección elegida. Backend, bases, integración y topología: diseño por implementar y validar. Nx organiza código y CI; no es un proceso runtime." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5053.695898" width="1482.670898" height="67.5" as="geometry" />
        </mxCell>
        <mxCell id="systemScope" value="" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;dashed=1;dashPattern=6 4;fillColor=#ffffff;rounded=0;arcSize=8;">
          <mxGeometry x="529.84375" y="430" width="2263.470703" height="1891.045898" as="geometry" />
        </mxCell>
        <mxCell id="systemScope-title" value="Sistema POS corporativo · propuesta" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="547.84375" y="444.399854" width="364.385742" height="27.5" as="geometry" />
        </mxCell>
        <mxCell id="cashier" value="" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#163A73;strokeWidth=1.5;fillColor=#163A73;rounded=1;arcSize=8;">
