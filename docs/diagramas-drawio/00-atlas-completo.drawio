          </mxGeometry>
        </mxCell>
        <mxCell id="step-2" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="597" y="1156.5" as="sourcePoint" />
            <mxPoint x="951" y="1156.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-2-note" value="La publicación y su evento se confirman juntos; el feed conserva los deltas. El manifiesto registra un watermark: corte consistente de origen desde el que recuperarlos. Una hora arbitraria del proceso no sustituye este corte." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="1214.5" width="1973.28125" height="25" as="geometry" />
        </mxCell>
        <mxCell id="step-3-label" value="04  Solicita deltas o snapshot ·&#10;HTTPS autenticado" parent="step-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="0" y="0" width="299.621094" height="55" as="geometry" relative="1">
            <mxPoint x="-159.5" y="-70" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step-3" value="" parent="1" edge="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;edgeStyle=none;rounded=0;startArrow=none;endArrow=open;endSize=10;">
