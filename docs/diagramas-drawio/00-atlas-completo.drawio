        <mxCell id="key-4" value="" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#946019;strokeWidth=1.5;fillColor=#946019;rounded=1;arcSize=8;">
          <mxGeometry x="952.816406" y="290" width="18" height="18" as="geometry" />
        </mxCell>
        <mxCell id="key-text-4" value="Infraestructura / condición" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="980.816406" y="285" width="230.117188" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-desc" value="Flecha: iniciador → destino; texto: propósito y protocolo. Borde discontinuo: límite nombrado. Todo el contenido es editable." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=19;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="330" width="1039.266602" height="23.75" as="geometry" />
        </mxCell>
        <mxCell id="reading-title" value="Contratos que gobiernan esta vista" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2817.135645" width="496.3125" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-2881-0-bg" value="" parent="group-notes-2881-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2881-0-title" value="Un monolito modular, un proceso" parent="group-notes-2881-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="366.870117" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2881-0-body" value="Los bloques interiores llaman código TypeScript. No hay HTTP ni bases&#10;separadas entre módulos. UI valida experiencia; el backend valida&#10;permisos, integridad, turno y capacidades antes de mutar negocio." parent="group-notes-2881-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="700.680664" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2881-1-bg" value="" parent="group-notes-2881-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2881-1-title" value="Transacción y efectos externos" parent="group-notes-2881-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="345.068359" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2881-1-body" value="Intención de pago durable antes de invocar el proveedor; resultado y&#10;confirmación local después. Venta + auditoría + outbox se confirman&#10;juntas. Venta, pago, fiscalidad y ERP conservan estados separados y&#10;recuperación explícita." parent="group-notes-2881-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="677.520508" height="110" as="geometry" />
        </mxCell>
        <mxCell id="notes-2881-2-bg" value="" parent="group-notes-2881-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="219.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2881-2-title" value="Precios y caja son dominios diferentes" parent="group-notes-2881-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="426.599121" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2881-2-body" value="La cotización fija versión inmutable y revalida vigencia antes de cobrar.&#10;Turno de caja no equivale a sesión de acceso. Devoluciones y&#10;compensaciones son nuevas operaciones auditables; no reescritura de&#10;historia." parent="group-notes-2881-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="693.429688" height="110" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="3159.385645" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-0-bg" value="" parent="group-notes-3234-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-0-title" value="Cliente de caja" parent="group-notes-3234-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="165.380859" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-0-body" value="Contenedor · Angular + Tauri&#10;&#10;Cliente instalado en cada puesto. Capacidades nativas por permisos; su&#10;registro técnico de periféricos no lo convierte en autoridad de ventas.&#10;Hardware y SDK requieren homologación.&#10;&#10;AUTORIDAD · No posee otra base de ventas ni credenciales SQL.&#10;&#10;CONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se&#10;detienen nuevos comandos dependientes." parent="group-notes-3234-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="704.418945" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-1-bg" value="" parent="group-notes-3234-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-1-title" value="API de comandos" parent="group-notes-3234-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="197.338867" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-1-body" value="Componente · Controllers NestJS / Fastify&#10;&#10;Autentica el puesto, valida esquema, propaga commandId y contexto de&#10;usuario/sucursal, aplica límites y entrega un resultado inequívoco o&#10;pendiente.&#10;&#10;AUTORIDAD · Contrato del backend; no escribe tablas por fuera de los&#10;casos de uso.&#10;&#10;CONTINUIDAD · API local por LAN; rechaza comandos cuando falta una&#10;capacidad requerida." parent="group-notes-3234-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="712.873047" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-2-bg" value="" parent="group-notes-3234-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-2-title" value="Acceso y permisos" parent="group-notes-3234-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="209.790039" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-2-body" value="Componente · Guards + servicios TypeScript&#10;&#10;La identidad del usuario y la del puesto se verifican en comandos; el menú&#10;no constituye la frontera de autorización.&#10;&#10;AUTORIDAD · Permisos y evidencia de sesión según política local&#10;autorizada.&#10;&#10;CONTINUIDAD · La vigencia offline y revocación requieren política&#10;expresa; no acceso indefinido." parent="group-notes-3234-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="727.675781" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-3-bg" value="" parent="group-notes-3234-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-3-title" value="Ventas y devoluciones" parent="group-notes-3234-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="248.779297" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-3-body" value="Componente · Módulo NestJS / TypeScript&#10;&#10;Fija versión de precios al preparar la venta, registra intención y resultado&#10;de pagos y documentos; compensaciones y devoluciones son nuevas&#10;operaciones auditables.&#10;&#10;AUTORIDAD · Escritor de ventas y devoluciones; conserva referencias,&#10;versiones y estados.&#10;&#10;CONTINUIDAD · Permite solo operaciones soportadas por datos, límites y&#10;política vigentes." parent="group-notes-3234-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="726.268555" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-4-bg" value="" parent="group-notes-3234-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-4-title" value="Precios y ofertas" parent="group-notes-3234-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="186.181641" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-4-body" value="Componente · Motor TypeScript local&#10;&#10;Lee una versión completa validada e inmutable. Los deltas construyen una&#10;nueva candidata aislada a partir de la versión base; nunca parchean la&#10;activa. La cotización conserva versión, origen y reglas; la venta en curso&#10;no cambia de versión.&#10;&#10;AUTORIDAD · Lector del espejo PostgreSQL; no redefine el maestro&#10;corporativo.&#10;&#10;CONTINUIDAD · No depende de una consulta de precio remoto para las&#10;ventas offline autorizadas." parent="group-notes-3234-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="728.911133" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-5-bg" value="" parent="group-notes-3234-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-5-title" value="Turnos y caja" parent="group-notes-3234-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="149.133301" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-5-body" value="Componente · Módulo NestJS / TypeScript&#10;&#10;Turno, saldo de efectivo, depósito y cierre son conceptos distintos de&#10;sesión de acceso. Los movimientos monetarios requieren identidad y&#10;transición validada.&#10;&#10;AUTORIDAD · Libro de movimientos y turnos de sucursal, con autorización&#10;y auditoría.&#10;&#10;CONTINUIDAD · Opera localmente; excepciones y límites requieren una&#10;política aprobada." parent="group-notes-3234-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="733.229492" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-6-bg" value="" parent="group-notes-3234-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-6-title" value="Pagos y adaptadores" parent="group-notes-3234-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="236.279297" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-6-body" value="Componente · Puertos + TypeScript&#10;&#10;No sostiene una transacción SQL abierta mientras espera el proveedor.&#10;Persiste intención antes de llamar y resultado después; procesos nativos&#10;auxiliares quedan sujetos al contrato de cada SDK.&#10;&#10;AUTORIDAD · Conserva identidad de intento y referencia del proveedor;&#10;no inventa resultado.&#10;&#10;CONTINUIDAD · Si el proveedor no responde: pendiente/desconocido,&#10;consulta o resolución operativa." parent="group-notes-3234-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="710.499023" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-7-bg" value="" parent="group-notes-3234-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-7-title" value="Fiscalidad y adaptadores" parent="group-notes-3234-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="277.941895" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-7-body" value="Componente · Puertos + TypeScript&#10;&#10;Separa confirmación de venta de validez fiscal. Un timeout fiscal mantiene&#10;la referencia original y la incertidumbre hasta consultar o conciliar.&#10;&#10;AUTORIDAD · Conserva identidad del documento y estados de&#10;emisión/aceptación/transmisión.&#10;&#10;CONTINUIDAD · Solo modalidades legal y técnicamente habilitadas; falta&#10;de capacidad bloquea esa acción." parent="group-notes-3234-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="725.151367" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-8-bg" value="" parent="group-notes-3234-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-8-title" value="Persistencia transaccional" parent="group-notes-3234-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="290.41748" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-8-body" value="Componente · Repositorios TypeScript / SQL&#10;&#10;Coordina cambios locales y outbox en la misma transacción. La&#10;transacción no engloba al proveedor externo ni al ERP; esos efectos&#10;tienen recuperación propia.&#10;&#10;AUTORIDAD · Un commit sobre PostgreSQL de sucursal; restricciones e&#10;idempotencia de comandos.&#10;&#10;CONTINUIDAD · La operación no se confirma si el commit falla. Falta de&#10;disco exige política de bloqueo." parent="group-notes-3234-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="713.603516" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-9-bg" value="" parent="group-notes-3234-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-9-title" value="Datos de sucursal" parent="group-notes-3234-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="200.097656" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-9-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Ventas, caja, pagos y evidencia fiscal son locales. Inbox, outbox, cursores&#10;y staging tienen restricciones y transacciones. Catálogo, precios y&#10;promociones son réplicas de lectura autorizadas, no maestros&#10;independientes.&#10;&#10;AUTORIDAD · Base compartida por la tienda, un primario autorizado. API&#10;escribe negocio; worker escribe su esquema técnico y publica espejos por&#10;un contrato acotado.&#10;&#10;CONTINUIDAD · Persistencia local disponible sin WAN. No implica&#10;respaldo, alta disponibilidad ni recuperación automática." parent="group-notes-3234-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="723.9375" height="357.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-10-bg" value="" parent="group-notes-3234-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-10-title" value="Proveedor de pagos" parent="group-notes-3234-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-10-body" value="Sistema externo · API / SDK según proveedor&#10;&#10;Pago, venta, documento fiscal e integración ERP tienen estados distintos.&#10;No repetir un cargo incierto ni cambiar de proveedor para resolverlo&#10;automáticamente.&#10;&#10;AUTORIDAD · El proveedor mantiene el efecto financiero; POS registra&#10;intento, referencia y resultado.&#10;&#10;CONTINUIDAD · Disponibilidad y modo offline por homologar. Un timeout&#10;puede dejar resultado desconocido." parent="group-notes-3234-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="720.317383" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-11-bg" value="" parent="group-notes-3234-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="777.357812" height="466.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-11-title" value="Proveedor fiscal" parent="group-notes-3234-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="179.248047" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-3234-11-body" value="Sistema externo · Contrato por país y modalidad&#10;&#10;Emisión, aceptación y transmisión se modelan por separado. No se&#10;inventa un proveedor común ni una capacidad de consulta o idempotencia&#10;no acreditada.&#10;&#10;AUTORIDAD · Autoridad y validez tributaria según régimen y proveedor.&#10;&#10;CONTINUIDAD · Emitir offline exige modalidad y material fiscal válidos; no&#10;se promete universalmente." parent="group-notes-3234-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="728.288086" height="275" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5094.885645" width="1424.169922" height="25" as="geometry" />
        </mxCell>
        <mxCell id="glossary" value="LAN: red de tienda · WAN: enlace a país · ACK: acuse de aplicación durable · ACL: capa anticorrupción · outbox/inbox: registros de envío/recepción · watermark: corte consistente del origen" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5160.885645" width="1681.240234" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FUENTES DEL REPOSITORIO&#10;docs/c4-arquitectura-propuesta.md  ·  docs/propuesta-arquitectura.md  ·  docs/opciones-tecnologicas.md  ·  docs/operacion-caja-y-evolucion.md  ·  docs/revision-resiliencia-datos-pos.md&#10;Angular + Tauri y Nx: dirección elegida. Backend, bases, integración y topología: diseño por implementar y validar. Nx organiza código y CI; no es un proceso runtime." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="5229.885645" width="1482.670898" height="67.5" as="geometry" />
        </mxCell>
