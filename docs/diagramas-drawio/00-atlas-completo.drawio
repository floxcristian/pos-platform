        <mxCell id="group-notes-3715-4" value="" parent="1" vertex="1" style="group;html=0;container=1;collapsible=0;recursiveResize=0;">
          <mxGeometry x="900.333333" y="3957.75" width="812.333333" height="219.25" as="geometry" />
