        </mxCell>
        <mxCell id="notes-2449-0-title" value="Frontera de continuidad" parent="group-notes-2449-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="264.0625" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2449-0-body" value="Sin WAN pueden continuar operaciones autorizadas con LAN y escritor sanos. Sin LAN/backend se detienen&#10;nuevos comandos dependientes; el puesto no se convierte en escritor de emergencia. La autonomía por terminal&#10;sería otro perfil de arquitectura." parent="group-notes-2449-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1103.115234" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2449-1-bg" value="" parent="group-notes-2449-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1183.724805" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2449-1-title" value="Seguridad y operación" parent="group-notes-2449-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="250.170898" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2449-1-body" value="Identidad de usuario y puesto, permisos por sucursal/país, TLS y credenciales de mínimos privilegios. Logs&#10;correlacionan commandId/eventId/intento. Observar cola pendiente, antigüedad, fallos, huecos y versión/vigencia&#10;activa." parent="group-notes-2449-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1104.329102" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2449-2-bg" value="" parent="group-notes-2449-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="1183.724805" height="191.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2449-2-title" value="Recuperación y decisiones pendientes" parent="group-notes-2449-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="428.051758" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2449-2-body" value="Backups fuera de la instancia y ensayos de restore. RPO/RTO, retención, dimensionamiento, sistema operativo,&#10;alojamiento y alta disponibilidad deben validarse. Excluir al escritor antiguo antes de recuperar; réplica no reemplaza&#10;backup." parent="group-notes-2449-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="1137.307617" height="82.5" as="geometry" />
        </mxCell>
        <mxCell id="details-title" value="Responsabilidades, propiedad y comportamiento ante fallos" parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=32;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="2699.504492" width="848.515625" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-0-bg" value="" parent="group-notes-2775-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="881.793604" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-0-title" value="Cliente de caja" parent="group-notes-2775-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="165.380859" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-0-body" value="Contenedor · Angular + Tauri&#10;&#10;Cliente instalado en cada puesto. Capacidades nativas por permisos; su registro&#10;técnico de periféricos no lo convierte en autoridad de ventas. Hardware y SDK&#10;requieren homologación.&#10;&#10;AUTORIDAD · No posee otra base de ventas ni credenciales SQL.&#10;&#10;CONTINUIDAD · Sin WAN usa la API por LAN. Sin LAN o backend, se detienen&#10;nuevos comandos dependientes." parent="group-notes-2775-0" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="783.889648" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-1-bg" value="" parent="group-notes-2775-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="881.793604" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-1-title" value="Puente de periféricos" parent="group-notes-2775-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="236.254883" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-1-body" value="Contenedor condicional · Proceso nativo según SDK&#10;&#10;El cliente transporta el comando autorizado por backend al agente; no inventa&#10;importe, permiso ni otro intento. Puede requerir .NET u otro runtime por contrato del&#10;proveedor. Se representa como límite por homologar, no como SDK aprobado.&#10;&#10;AUTORIDAD · Ejecuta identidad y autorización emitidas por backend; registro técnico&#10;de evidencia, sin base de ventas.&#10;&#10;CONTINUIDAD · Una caída de LAN tras un cobro exige recuperar evidencia; no&#10;autoriza otro cobro." parent="group-notes-2775-1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="835.989258" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-2-bg" value="" parent="group-notes-2775-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="881.793604" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-2-title" value="Backend de sucursal" parent="group-notes-2775-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="232.080078" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-2-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;Monolito modular: acceso, ventas, caja, precios/ofertas, pagos y fiscalidad. Confirma&#10;negocio y outbox en una misma transacción PostgreSQL. No hay un microservicio&#10;por módulo.&#10;&#10;AUTORIDAD · Única autoridad de escritura del negocio de sucursal; módulos&#10;internos, un proceso.&#10;&#10;CONTINUIDAD · Opera por LAN con datos vigentes. Su caída exige recuperación del&#10;escritor autorizado." parent="group-notes-2775-2" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="836.397461" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-3-bg" value="" parent="group-notes-2775-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="881.793604" height="439.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-3-title" value="Datos de sucursal" parent="group-notes-2775-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="200.097656" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-3-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Ventas, caja, pagos y evidencia fiscal son locales. Inbox, outbox, cursores y staging&#10;tienen restricciones y transacciones. Catálogo, precios y promociones son réplicas de&#10;lectura autorizadas, no maestros independientes.&#10;&#10;AUTORIDAD · Base compartida por la tienda, un primario autorizado. API escribe&#10;negocio; worker escribe su esquema técnico y publica espejos por un contrato&#10;acotado.&#10;&#10;CONTINUIDAD · Persistencia local disponible sin WAN. No implica respaldo, alta&#10;disponibilidad ni recuperación automática." parent="group-notes-2775-3" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="835.194336" height="330" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-4-bg" value="" parent="group-notes-2775-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="881.793604" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-4-title" value="Sincronizador de sucursal" parent="group-notes-2775-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="287.646484" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-4-body" value="Contenedor · Worker TypeScript / Node.js&#10;&#10;Envía lotes HTTPS desde outbox con identidad y cursor; procesa acuses posteriores&#10;a commit. Recibe deltas o carga snapshot por staging, watermark, checksum y&#10;activación atómica.&#10;&#10;AUTORIDAD · Proceso supervisado; modifica datos técnicos y versiones de&#10;maestros, nunca venta libremente.&#10;&#10;CONTINUIDAD · Retiene pendientes durables y reanuda al recuperar WAN; limita&#10;reintentos y trabajo en curso." parent="group-notes-2775-4" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="827.878906" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-5-bg" value="" parent="group-notes-2775-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="881.793604" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-5-title" value="API de país" parent="group-notes-2775-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="129.248047" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-5-body" value="Contenedor · NestJS + Fastify / Node.js&#10;&#10;Valida identidad y contrato; aplica el efecto/proyección local junto con inbox y outbox&#10;en un único commit antes de acusar aplicación. No basta guardar la recepción. El&#10;ACK no declara éxito de ERP, pago ni fiscalidad.&#10;&#10;AUTORIDAD · Autentica sucursal y país; confirma inbox, efecto local y outbox juntos&#10;antes del ACK de aplicación.&#10;&#10;CONTINUIDAD · No participa en la transacción local de sucursal. Su caída genera&#10;atraso de sincronización." parent="group-notes-2775-5" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="826.181641" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-6-bg" value="" parent="group-notes-2775-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="881.793604" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-6-title" value="Workers de país" parent="group-notes-2775-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="181.555176" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-6-body" value="Contenedor · Workers NestJS / Node.js&#10;&#10;Procesa trabajo ya confirmado localmente para integración y conciliación; no difiere el&#10;efecto local requerido por el ACK de aplicación. Ingiere maestros autorizados,&#10;construye candidatas desde deltas o snapshots y valida su publicación.&#10;&#10;AUTORIDAD · Consume outbox confirmada por país; publica maestros y mantiene&#10;proyecciones derivadas.&#10;&#10;CONTINUIDAD · Avanza independientemente de tiendas desconectadas y limita&#10;fallos del ERP por país." parent="group-notes-2775-6" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="837.675781" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-7-bg" value="" parent="group-notes-2775-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="881.793604" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-7-title" value="Datos operativos de país" parent="group-notes-2775-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="276.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-7-body" value="Contenedor de datos · PostgreSQL&#10;&#10;Aislamiento lógico y recursos por país/entidad legal. Retención, backups y&#10;deduplicación deben cubrir el horizonte de replay y restauración. ACK de aplicación&#10;local no equivale a contabilización ERP.&#10;&#10;AUTORIDAD · Proyección de operaciones de sucursal; inbox, outbox, versiones y&#10;resultados de integración.&#10;&#10;CONTINUIDAD · No sustituye la autoridad local ni habilita consumo concurrente&#10;offline de saldos globales." parent="group-notes-2775-7" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="815.708008" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-8-bg" value="" parent="group-notes-2775-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="881.793604" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-8-title" value="Adaptador ERP / ACL" parent="group-notes-2775-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="243.188477" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-8-body" value="Contenedor · Proceso TypeScript / Node.js&#10;&#10;ACL significa capa anticorrupción. Instancia/adaptador por país y ERP. Traduce&#10;identidades, documentos, moneda, impuestos, estados y errores; preserva destino y&#10;versión durante un cambio de ERP. El protocolo externo se valida por integración.&#10;&#10;AUTORIDAD · Dueño del mapeo y referencias técnicas; ERP conserva su autoridad&#10;de negocio.&#10;&#10;CONTINUIDAD · Desacoplado de la caja; conserva incertidumbre si no puede&#10;consultar un resultado." parent="group-notes-2775-8" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="823.001953" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-9-bg" value="" parent="group-notes-2775-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="881.793604" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-9-title" value="ERP del país" parent="group-notes-2775-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="145.910645" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-9-body" value="Sistema externo · CL: AX · ES: Gira · PE: custom&#10;&#10;Chile usa Dynamics AX on-premise. Gira en España y custom en Perú son&#10;antecedentes; versión, interfaces y capacidades deben confirmarse. No se afirma que&#10;exista el adaptador objetivo en producción.&#10;&#10;AUTORIDAD · Autoridad financiera según contrato de cada país; no la base de&#10;ventas del POS.&#10;&#10;CONTINUIDAD · Su indisponibilidad deja integración pendiente; no revierte una&#10;venta local confirmada." parent="group-notes-2775-9" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="837.686523" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-10-bg" value="" parent="group-notes-2775-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="881.793604" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-10-title" value="Proveedor de pagos" parent="group-notes-2775-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="225.158691" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-10-body" value="Sistema externo · API / SDK según proveedor&#10;&#10;Pago, venta, documento fiscal e integración ERP tienen estados distintos. No repetir&#10;un cargo incierto ni cambiar de proveedor para resolverlo automáticamente.&#10;&#10;AUTORIDAD · El proveedor mantiene el efecto financiero; POS registra intento,&#10;referencia y resultado.&#10;&#10;CONTINUIDAD · Disponibilidad y modo offline por homologar. Un timeout puede&#10;dejar resultado desconocido." parent="group-notes-2775-10" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="823.023438" height="275" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-11-bg" value="" parent="group-notes-2775-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="881.793604" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-11-title" value="Proveedor fiscal" parent="group-notes-2775-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="179.248047" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-11-body" value="Sistema externo · Contrato por país y modalidad&#10;&#10;Emisión, aceptación y transmisión se modelan por separado. No se inventa un&#10;proveedor común ni una capacidad de consulta o idempotencia no acreditada.&#10;&#10;AUTORIDAD · Autoridad y validez tributaria según régimen y proveedor.&#10;&#10;CONTINUIDAD · Emitir offline exige modalidad y material fiscal válidos; no se&#10;promete universalmente." parent="group-notes-2775-11" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="765.53125" height="247.5" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-12-bg" value="" parent="group-notes-2775-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#CCD7E8;strokeWidth=1.5;fillColor=#F7F9FD;rounded=1;arcSize=8;">
          <mxGeometry x="0" y="0" width="881.793604" height="411.75" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-12-title" value="Respaldo y recuperación" parent="group-notes-2775-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#0545BA;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#0545BA;fontSize=25;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="22" width="276.550293" height="31.25" as="geometry" />
        </mxCell>
        <mxCell id="notes-2775-12-body" value="Infraestructura · Backups PostgreSQL / herramienta por definir&#10;&#10;Backups externos a la instancia, pruebas de restore y exclusión del escritor anterior.&#10;Una réplica no sustituye un backup; alta disponibilidad requiere diseño y ensayos&#10;separados.&#10;&#10;AUTORIDAD · Operaciones define retención, RPO/RTO y reconstrucción de&#10;evidencia.&#10;&#10;CONTINUIDAD · No es un segundo escritor activo ni garantiza continuidad&#10;inmediata." parent="group-notes-2775-12" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#182842;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#182842;fontSize=22;align=left;verticalAlign=top;">
          <mxGeometry x="22" y="74.25" width="820.541992" height="302.5" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="C4: contenedor = aplicación o almacén; componente = módulo dentro de un proceso. Despliegue y dinámicas son vistas complementarias, no el nivel de código." parent="1" vertex="1" style="html=0;fontFamily=Arial;shadow=0;spacing=0;opacity=100;strokeColor=#4C607D;strokeWidth=2;shape=text;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;fontColor=#4C607D;fontSize=20;align=left;verticalAlign=top;">
          <mxGeometry x="64" y="4580.004492" width="1424.169922" height="25" as="geometry" />
        </mxCell>
