{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "emitDecoratorMetadata": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "apps/pos-runtime/**/*.ts",
    "apps/pos-runtime/**/*.mts",
    "apps/country-api/**/*.ts",
    "apps/country-api/**/*.mts",
    "apps/pos-sync-worker/**/*.ts",
    "apps/pos-sync-worker/**/*.mts",
    "apps/erp-worker/**/*.ts",
    "apps/erp-worker/**/*.mts",
    "libs/backend/**/*.ts",
    "libs/platform/backend/**/*.ts",
    "libs/platform/backend/**/*.mts",
    "libs/contracts/**/*.ts",
    "libs/shared-kernel/**/*.ts",
    "libs/country-policies/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
