{
  "name": "pos-docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/pos-docs/src",
  "tags": ["type:docs", "scope:docs", "env:docs"],
  "namedInputs": {
    "documentation": [
      "{projectRoot}/**/*",
      "!{projectRoot}/node_modules/**/*",
      "!{projectRoot}/.astro/**/*",
      "{workspaceRoot}/docs/**/*",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/tools/export-documentation.mjs",
      "{workspaceRoot}/tools/diagrams/**/*",
      "!{workspaceRoot}/tools/diagrams/runtime/node_modules/**/*",
      "{workspaceRoot}/vercel.json",
      { "runtime": "git rev-parse HEAD" },
      { "runtime": "git status --porcelain" }
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["documentation"],
      "outputs": ["{workspaceRoot}/dist/apps/pos-docs"],
      "options": { "cwd": "apps/pos-docs", "command": "npm run build" }
    },
    "validate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["documentation"],
      "options": { "cwd": "apps/pos-docs", "command": "npm run validate" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["documentation"],
      "options": { "cwd": "apps/pos-docs", "command": "npm run typecheck" }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": { "cwd": "apps/pos-docs", "command": "npm run check" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "cwd": "apps/pos-docs", "command": "npm run dev" }
    },
    "preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": { "cwd": "apps/pos-docs", "command": "npm run preview" }
    }
  }
}
