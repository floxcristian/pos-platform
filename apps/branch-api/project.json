{
  "name": "branch-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/branch-api/src",
  "tags": ["type:backend", "env:server", "scope:branch"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production", "{workspaceRoot}/tools/backend/**/*"],
      "outputs": ["{workspaceRoot}/dist/apps/branch-api"],
      "options": {
        "command": "rspack build",
        "cwd": "apps/branch-api"
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "continuous": true,
      "options": {
        "buildTarget": "branch-api:build",
        "watch": true,
        "inspect": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/branch-api --max-warnings 0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/tools/backend/**/*"],
      "options": {
        "command": "tsc -p apps/branch-api/tsconfig.spec.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/tools/backend/**/*"],
      "options": {
        "command": "vitest run --config apps/branch-api/vitest.config.mts"
      }
    }
  }
}
