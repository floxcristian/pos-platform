# Nx tasks load a local app .env. Direct Node execution needs process variables or --env-file.
NODE_ENV=development
COUNTRY_API_HOST=127.0.0.1
COUNTRY_API_PORT=3001
COUNTRY_API_LOG_LEVEL=info
# Defaults to false in production.
COUNTRY_API_DOCS_ENABLED=true
# Comma-separated exact HTTP(S) origins; empty means no CORS access.
COUNTRY_API_CORS_ORIGINS=
# Error reporting is opt-in. Leave disabled and empty for the local demonstration.
COUNTRY_API_SENTRY_ENABLED=false
COUNTRY_API_SENTRY_DSN=
# Optional deployment version; do not include credentials or personal data.
COUNTRY_API_SENTRY_RELEASE=
# Bounded shutdown flush, from 1 to 10000 milliseconds.
COUNTRY_API_SENTRY_SHUTDOWN_TIMEOUT_MS=2000
