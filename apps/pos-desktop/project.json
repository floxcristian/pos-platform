{
  "name": "pos-desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/pos-desktop/src",
  "tags": ["type:app", "scope:desktop", "env:browser"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/pos-desktop",
        "browser": "apps/pos-desktop/src/main.ts",
        "index": "apps/pos-desktop/src/index.html",
        "tsConfig": "apps/pos-desktop/tsconfig.app.json",
        "assets": [{ "glob": "**/*", "input": "libs/ui/assets", "output": "/" }],
        "styles": ["libs/ui/src/styles.css"],
        "allowedCommonJsDependencies": []
      },
      "configurations": {
        "production": {
          "optimization": {
            "scripts": true,
            "styles": { "minify": true, "inlineCritical": false }
          },
          "budgets": [{ "type": "initial", "maximumWarning": "1.2MB", "maximumError": "1.5MB" }],
          "outputHashing": "all",
          "sourceMap": false
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "buildTarget": "pos-desktop:build:development",
        "host": "127.0.0.1",
        "port": 4300
      },
      "configurations": {
        "production": { "buildTarget": "pos-desktop:build:production" }
      }
    },
    "native-dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/pos-desktop",
        "command": "node ../../node_modules/@tauri-apps/cli/tauri.js dev"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{projectRoot}/src-tauri/target/release/bundle"],
      "options": {
        "cwd": "apps/pos-desktop",
        "command": "node ../../node_modules/@tauri-apps/cli/tauri.js build"
      }
    },
    "info": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/pos-desktop",
        "command": "node ../../node_modules/@tauri-apps/cli/tauri.js info"
      }
    }
  }
}
