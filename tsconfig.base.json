{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@pos-platform/client-shell": ["libs/client-shell/src/index.ts"],
      "@pos-platform/domain": ["libs/domain/src/index.ts"],
      "@pos-platform/data-access": ["libs/data-access/src/index.ts"],
      "@pos-platform/ui": ["libs/ui/src/index.ts"],
      "@pos-platform/administration": ["libs/backend/administration/src/index.ts"],
      "@pos-platform/sales": ["libs/backend/sales/src/index.ts"],
      "@pos-platform/cash": ["libs/backend/cash/src/index.ts"],
      "@pos-platform/payments": ["libs/backend/payments/src/index.ts"],
      "@pos-platform/collections": ["libs/backend/collections/src/index.ts"],
      "@pos-platform/returns": ["libs/backend/returns/src/index.ts"],
      "@pos-platform/pricing": ["libs/backend/pricing/src/index.ts"],
      "@pos-platform/catalog": ["libs/backend/catalog/src/index.ts"],
      "@pos-platform/fiscal": ["libs/backend/fiscal/src/index.ts"],
      "@pos-platform/devices": ["libs/backend/devices/src/index.ts"],
      "@pos-platform/sync": ["libs/backend/sync/src/index.ts"],
      "@pos-platform/erp": ["libs/backend/erp/src/index.ts"],
      "@pos-platform/reporting": ["libs/backend/reporting/src/index.ts"],
      "@pos-platform/shared-kernel": ["libs/shared-kernel/src/index.ts"],
      "@pos-platform/contracts": ["libs/contracts/src/index.ts"],
      "@pos-platform/country-policies": ["libs/country-policies/src/index.ts"],
      "@pos-platform/backend": ["libs/platform/backend/src/index.ts"],
      "@pos-platform/features/access": ["libs/features/access/src/index.ts"],
      "@pos-platform/features/checkout": ["libs/features/checkout/src/index.ts"],
      "@pos-platform/features/insights": ["libs/features/insights/src/index.ts"],
      "@pos-platform/features/administration": ["libs/features/administration/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
