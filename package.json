{
  "name": "pos-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/pos-mobile"
  ],
  "description": "Plataforma POS corporativa multipaís — monorepo Nx, Angular, Tauri, Capacitor y NestJS con demostración sintética y scaffolding de backend",
  "engines": {
    "node": ">=22.19 <23 || >=24 <25"
  },
  "scripts": {
    "start": "nx serve pos-desktop --host 127.0.0.1 --port 4300",
    "build": "nx run-many -t build -p pos-desktop pos-mobile --parallel=1",
    "lint": "node tools/lint-workspace.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons:generate": "node tools/generate-compact-icons.mjs && node tools/generate-duotone-icons.mjs",
    "icons:check": "node tools/generate-compact-icons.mjs --check && node tools/generate-duotone-icons.mjs --check",
    "check": "npm run icons:check && npm run lint && npm test && npm run build && npm run backend:check",
    "desktop:dev": "nx run pos-desktop:native-dev",
    "desktop:bundle": "nx build pos-desktop",
    "desktop:build": "nx run pos-desktop:package",
    "desktop:info": "nx run pos-desktop:info",
    "mobile:start": "nx serve pos-mobile --host 127.0.0.1 --port 4301",
    "mobile:build": "nx build pos-mobile",
    "mobile:sync:android": "nx run pos-mobile:sync-android",
    "mobile:sync:ios": "nx run pos-mobile:sync-ios",
    "mobile:android": "nx run pos-mobile:run-android",
    "mobile:ios": "nx run pos-mobile:run-ios",
    "test:e2e:mobile": "playwright test --config playwright.mobile.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:dev": "nx serve branch-api",
    "api:build": "nx build branch-api",
    "api:test": "nx test branch-api",
    "api:smoke": "npm run api:build && node tools/verify-api-artifact.mjs",
    "api:check": "nx run-many -t lint typecheck test build -p branch-api",
    "country:dev": "nx serve country-api",
    "sync:check": "nx run branch-sync-worker:check",
    "erp:check": "nx run erp-worker:check",
    "backend:build": "nx run-many -t build -p branch-api country-api branch-sync-worker erp-worker --parallel=3",
    "backend:check": "nx run-many -t lint typecheck test build -p tag:env:server tag:type:contract tag:type:kernel tag:type:policy --parallel=3",
    "backend:smoke": "npm run backend:build && node tools/verify-api-artifact.mjs --all",
    "structure:check": "vitest run tools/eslint/architecture-boundaries.spec.ts tools/eslint/backend-quality.spec.ts",
    "graph": "nx graph",
    "docs:install": "npm --prefix apps/pos-docs ci",
    "docs:dev": "nx serve pos-docs",
    "docs:build": "nx build pos-docs",
    "docs:validate": "nx run pos-docs:validate",
    "docs:typecheck": "nx run pos-docs:typecheck",
    "docs:check": "nx run pos-docs:check",
    "build:vercel": "npm run docs:build"
  },
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.2",
    "@fontsource-variable/inter": "5.2.8",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@primeuix/themes": "2.0.3",
    "@sentry/node": "10.76.2",
    "@tauri-apps/api": "2.12.1",
    "chart.js": "4.5.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.12.5",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "primeng": "21.1.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "21.2.27",
    "@angular-devkit/schematics": "21.2.27",
    "@angular/build": "21.2.27",
    "@angular/cli": "21.2.27",
    "@angular/compiler-cli": "21.2.25",
    "@axe-core/playwright": "4.11.3",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.1.3",
    "@nx/angular": "23.2.1",
    "@nx/devkit": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/rspack": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.59.1",
    "@rspack/cli": "2.2.9",
    "@rspack/core": "2.2.9",
    "@schematics/angular": "21.2.27",
    "@swc/core": "1.16.18",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "22.15.30",
    "angular-eslint": "21.4.0",
    "eslint": "10.12.0",
    "nx": "23.2.1",
    "postcss": "8.5.28",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@11.6.0"
}
