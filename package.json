{
  "name": "corporate-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Caja corporativa Chile — prototipo funcional Nx, Angular y Tauri con datos sintéticos",
  "engines": {
    "node": ">=22.13 <23 || >=24 <25"
  },
  "scripts": {
    "start": "nx serve pos-web --host 127.0.0.1 --port 4300",
    "build": "nx build pos-web",
    "lint": "eslint apps libs --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons:generate": "node tools/generate-compact-icons.mjs && node tools/generate-duotone-icons.mjs",
    "icons:check": "node tools/generate-compact-icons.mjs --check && node tools/generate-duotone-icons.mjs --check",
    "check": "npm run icons:check && npm run lint && npm test && npm run build",
    "desktop:dev": "nx run pos-desktop:dev",
    "desktop:build": "nx run pos-desktop:build",
    "desktop:info": "nx run pos-desktop:info",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@fontsource-variable/inter": "5.2.8",
    "@primeuix/themes": "2.0.3",
    "@tauri-apps/api": "2.12.1",
    "chart.js": "4.5.1",
    "primeng": "21.1.10",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "21.2.24",
    "@angular-devkit/schematics": "21.2.24",
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.25",
    "@axe-core/playwright": "4.11.3",
    "@eslint/js": "10.0.1",
    "@nx/angular": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.59.1",
    "@schematics/angular": "21.2.24",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "22.15.30",
    "angular-eslint": "21.4.0",
    "eslint": "10.12.0",
    "nx": "23.2.1",
    "postcss": "8.5.28",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@11.6.0"
}
